{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!!.next",
			"!!node_modules",
			"!!dist",
			"!!.vercel",
			"!!coverage",
			"!!.playwright-cli",
			"!!.antigravitycli",
			"!!.agents",
			"!!backups",
			"!!@backups"
		]
	},
	"css": {
		"parser": {
			"allowWrongLineComments": true,
			"tailwindDirectives": true
		}
	}
}
